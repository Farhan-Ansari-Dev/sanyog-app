{
  "expo": {
    "name": "Dice by Sanyog",
    "slug": "dice-by-sanyog",
    "version": "1.0.0",
    "scheme": "sanyog",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dicebysanyog.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.dicebysanyog.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "d16ad1ec-7e46-4fe3-8681-1c3f31998f62"
      }
    },
    "owner": "farhan_ansari"
  }
}
